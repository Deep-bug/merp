# Local vendor credentials. Commit only the matching *.example.json template.
/config/baidu_map.local.json
/config/environment.*.local.json
/config/webview.local.json
/config/qas.local.json
/config/mock.local.json
/config/prd.local.json

# Android production signing files must remain local or in the CI secret store.
/android/key.properties
/android/*.jks
/android/*.keystore
/android/app/*.jks
/android/app/*.keystore

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
