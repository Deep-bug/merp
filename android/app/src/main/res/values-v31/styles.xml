<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 会先显示系统 SplashScreen；这里显式指定品牌背景和图标。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/merp_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/merp_launch_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/merp_splash_background</item>
    </style>
</resources>
