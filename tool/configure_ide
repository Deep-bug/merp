#!/usr/bin/env bash

set -euo pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$TOOL_DIR/.." && pwd)"
LOCAL_RUN_FILE="$ROOT_DIR/.run/MERP_QAS_Android_Local.run.xml"
MOCK_LOCAL_RUN_FILE="$ROOT_DIR/.run/MERP_Mock_Android_Local.run.xml"

ensure_local_json() {
  local target="$1"
  local content="$2"
  if [[ ! -f "$target" ]]; then
    printf '%s\n' "$content" >"$target"
    printf '  [已生成] %s\n' "${target#"$ROOT_DIR/"}"
  fi
}

xml_escape() {
  printf '%s' "$1" |
    sed 's/&/\&amp;/g; s/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

mkdir -p "$ROOT_DIR/.run" "$ROOT_DIR/config" "$ROOT_DIR/ios/Config"

# 这些文件均被 Git 忽略。空值保证新电脑首次启动不会因为可选文件缺失而失败，
# 开发者随后可以直接填写本机 AK、私有 WebView 地址或 QAS 覆盖值。
ensure_local_json "$ROOT_DIR/config/qas.local.json" '{}'
ensure_local_json "$ROOT_DIR/config/mock.local.json" '{}'
ensure_local_json "$ROOT_DIR/config/prd.local.json" '{}'
# Migrate the old personal AK only to dev. Never reuse it for enterprise packages.
if [[ ! -f "$ROOT_DIR/config/baidu_map.dev.local.json" && -f "$ROOT_DIR/config/baidu_map.local.json" ]]; then
  cp "$ROOT_DIR/config/baidu_map.local.json" "$ROOT_DIR/config/baidu_map.dev.local.json"
  printf '  [已迁移] 旧地图 Key 已复制到 dev；原文件保留，后续不再读取。\n'
fi
for profile in dev qas prd; do
  if [[ ! -f "$ROOT_DIR/config/baidu_map.$profile.local.json" ]]; then
    cp "$ROOT_DIR/config/baidu_map.example.json" "$ROOT_DIR/config/baidu_map.$profile.local.json"
  fi
done
for profile in Dev Qas Prd; do
  if [[ ! -f "$ROOT_DIR/ios/Config/$profile.local.xcconfig" ]]; then
    cp "$ROOT_DIR/ios/Config/$profile.example.xcconfig" "$ROOT_DIR/ios/Config/$profile.local.xcconfig"
  fi
done
ensure_local_json "$ROOT_DIR/config/webview.local.json" '{}'

ADDITIONAL_ARGS=(
  "--dart-define-from-file=config/qas.json"
  "--dart-define-from-file=config/qas.local.json"
  "--dart-define-from-file=config/baidu_map.dev.local.json"
  "--dart-define-from-file=config/webview.local.json"
  "--dart-define=MERP_BUILD_PROFILE=dev"
)
ARGS_TEXT="${ADDITIONAL_ARGS[*]}"
ESCAPED_ARGS="$(xml_escape "$ARGS_TEXT")"
TEMP_RUN_FILE="$LOCAL_RUN_FILE.tmp.$$"
MOCK_TEMP_RUN_FILE="$MOCK_LOCAL_RUN_FILE.tmp.$$"

{
  printf '%s\n' '<component name="ProjectRunConfigurationManager">'
  printf '%s\n' \
    '  <configuration default="false" name="MERP DEV QAS Android (Local)" type="FlutterRunConfigurationType" factoryName="Flutter">'
  printf '    <option name="additionalArgs" value="%s" />\n' "$ESCAPED_ARGS"
  printf '%s\n' '    <option name="buildFlavor" value="dev" />'
  printf '%s\n' '    <option name="filePath" value="$PROJECT_DIR$/lib/main.dart" />'
  printf '%s\n' '    <method v="2" />'
  printf '%s\n' '  </configuration>'
  printf '%s\n' '</component>'
} >"$TEMP_RUN_FILE"
mv "$TEMP_RUN_FILE" "$LOCAL_RUN_FILE"

MOCK_ADDITIONAL_ARGS=(
  "--dart-define-from-file=config/qas.json"
  "--dart-define-from-file=config/qas.local.json"
  "--dart-define-from-file=config/mock.json"
  "--dart-define-from-file=config/mock.local.json"
  "--dart-define-from-file=config/baidu_map.dev.local.json"
  "--dart-define-from-file=config/webview.local.json"
  "--dart-define=MERP_BUILD_PROFILE=dev"
)
MOCK_ARGS_TEXT="${MOCK_ADDITIONAL_ARGS[*]}"
MOCK_ESCAPED_ARGS="$(xml_escape "$MOCK_ARGS_TEXT")"
{
  printf '%s\n' '<component name="ProjectRunConfigurationManager">'
  printf '%s\n' \
    '  <configuration default="false" name="MERP DEV MOCK Android (Local)" type="FlutterRunConfigurationType" factoryName="Flutter">'
  printf '    <option name="additionalArgs" value="%s" />\n' "$MOCK_ESCAPED_ARGS"
  printf '%s\n' '    <option name="buildFlavor" value="dev" />'
  printf '%s\n' '    <option name="filePath" value="$PROJECT_DIR$/lib/main.dart" />'
  printf '%s\n' '    <method v="2" />'
  printf '%s\n' '  </configuration>'
  printf '%s\n' '</component>'
} >"$MOCK_TEMP_RUN_FILE"
mv "$MOCK_TEMP_RUN_FILE" "$MOCK_LOCAL_RUN_FILE"

printf '  [已生成] .run/MERP_QAS_Android_Local.run.xml\n'
printf '  [已生成] .run/MERP_Mock_Android_Local.run.xml\n'
printf 'IDE 本地配置完成。共享配置不依赖密钥，本地配置会加载本机覆盖文件。\n'
