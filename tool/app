#!/usr/bin/env bash

set -euo pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$TOOL_DIR/.." && pwd)"
# shellcheck source=tool/versions
source "$TOOL_DIR/versions"

FVM_PLATFORM="macos-x64"
[[ "$(uname -m)" == "arm64" ]] && FVM_PLATFORM="macos-arm64"
FVM_BIN="$ROOT_DIR/.tool-cache/fvm/$FVM_VERSION/$FVM_PLATFORM/fvm"

usage() {
  cat <<'HELP'
用法：
  ./tool/app doctor
  ./tool/app ide
  ./tool/app analyze
  ./tool/app test
  ./tool/app run qas android [Flutter 额外参数]
  ./tool/app run qas android --recover [-d <device-id>] [Flutter 额外参数]
  ./tool/app run qas ios [Flutter 额外参数]
  ./tool/app run mock android [Flutter 额外参数]
  ./tool/app run mock ios [Flutter 额外参数]
  ./tool/app build qas android [Flutter 额外参数]
  ./tool/app build qas ios [Flutter 额外参数]
  IOS_OTA_BASE_URL=https://example.com/merp/ios ./tool/app build qas ios-ota [Flutter 额外参数]
  ./tool/app build prd android [Flutter 额外参数]
  ./tool/app build prd ios [Flutter 额外参数]

版本覆盖：
  BUILD_NAME=1.2.0 BUILD_NUMBER=10001 ./tool/app build qas android

iOS OTA：
  ios-ota 会构建 Ad Hoc IPA，并在 build/ios/ota/qas 生成 manifest.plist。
  IOS_OTA_BASE_URL 必须填写服务器上存放 IPA 和 plist 的 HTTPS 目录。

Android 恢复启动：
  --recover 仅用于 Android run。启动前会停止目标设备上的 MERP 残留进程，
  并清理该设备的旧 ADB 端口转发；不会卸载 App 或清除用户数据。
HELP
}

fail() {
  printf '错误：%s\n\n' "$*" >&2
  usage >&2
  exit 1
}

ensure_fvm() {
  if [[ ! -x "$FVM_BIN" ]]; then
    printf '尚未初始化项目工具链，正在执行 bootstrap...\n'
    "$TOOL_DIR/bootstrap"
  fi
}

ensure_android_java() {
  local java_bin=""
  local java_major=""
  local java_version_line=""
  local android_studio_java_home="/Applications/Android Studio.app/Contents/jbr/Contents/Home"

  if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
    java_bin="$JAVA_HOME/bin/java"
  else
    java_bin="$(command -v java 2>/dev/null || true)"
  fi

  if [[ -n "$java_bin" ]]; then
    java_version_line="$("$java_bin" -version 2>&1 | head -n 1)"
    if [[ "$java_version_line" == *'version "1.'* ]]; then
      java_major="$(printf '%s' "$java_version_line" | sed -E 's/.*version "1\.([0-9]+).*/\1/')"
    else
      java_major="$(printf '%s' "$java_version_line" | sed -E 's/.*version "([0-9]+).*/\1/')"
    fi
  fi

  if [[ "$java_major" =~ ^[0-9]+$ && "$java_major" -ge 17 ]]; then
    return
  fi

  if [[ -x "$android_studio_java_home/bin/java" ]]; then
    export JAVA_HOME="$android_studio_java_home"
    export PATH="$JAVA_HOME/bin:$PATH"
    printf '当前 Java 版本不满足 Android 构建要求，已使用 Android Studio 内置 JDK。\n'
    return
  fi

  fail "Android 构建需要 JDK 17 以上；请安装 Android Studio，或将 JAVA_HOME 指向可用 JDK。"
}

flutter() {
  FVM_NO_ANALYTICS=1 "$FVM_BIN" flutter "$@"
}

project_version() {
  sed -n 's/^version:[[:space:]]*\([^+[:space:]]*\).*/\1/p' "$ROOT_DIR/pubspec.yaml"
}

project_build_number() {
  sed -n 's/^version:[[:space:]]*[^+[:space:]]*+\([0-9][0-9]*\).*/\1/p' "$ROOT_DIR/pubspec.yaml"
}

config_args() {
  local environment="$1"
  local base_environment="$environment"
  if [[ "$environment" == "mock" ]]; then
    # mock 复用 QAS 地址与本机覆盖，最后再由 mock.json 覆盖 APP_ENV 与 Mock 开关。
    base_environment="qas"
  fi
  local base_file="$ROOT_DIR/config/$base_environment.json"
  local override_file="$ROOT_DIR/config/$base_environment.local.json"

  [[ -f "$base_file" ]] || fail "缺少环境配置：$base_file"
  CONFIG_ARGUMENTS=("--dart-define-from-file=$base_file")
  [[ -f "$override_file" ]] && CONFIG_ARGUMENTS+=("--dart-define-from-file=$override_file")
  if [[ "$environment" == "mock" ]]; then
    CONFIG_ARGUMENTS+=("--dart-define-from-file=$ROOT_DIR/config/mock.json")
    [[ -f "$ROOT_DIR/config/mock.local.json" ]] &&
      CONFIG_ARGUMENTS+=("--dart-define-from-file=$ROOT_DIR/config/mock.local.json")
  fi
  [[ -f "$ROOT_DIR/config/baidu_map.local.json" ]] &&
    CONFIG_ARGUMENTS+=("--dart-define-from-file=$ROOT_DIR/config/baidu_map.local.json")
  [[ -f "$ROOT_DIR/config/webview.local.json" ]] &&
    CONFIG_ARGUMENTS+=("--dart-define-from-file=$ROOT_DIR/config/webview.local.json")
}

validate_prd_config() {
  local source_file="$ROOT_DIR/config/prd.json"
  [[ -f "$ROOT_DIR/config/prd.local.json" ]] &&
    source_file="$ROOT_DIR/config/prd.local.json"
  local api_url
  api_url="$(sed -n 's/.*"API_BASE_URL"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$source_file")"
  if [[ -z "$api_url" || "$api_url" == *"替换"* || "$api_url" == *"placeholder"* ]]; then
    fail "PRD API_BASE_URL 尚未配置。请创建被 Git 忽略的 config/prd.local.json，或由 CI 安全生成。"
  fi
}

confirm_prd() {
  if [[ "${CI:-}" == "true" || "${CI:-}" == "1" ]]; then
    return
  fi
  printf '\n警告：即将构建 PRD 正式包，不会自动上传应用商店。\n'
  printf '请输入 prd 继续：'
  read -r confirmation
  [[ "$confirmation" == "prd" ]] || {
    printf '已取消 PRD 构建。\n'
    exit 1
  }
}

has_device_argument() {
  local argument
  for argument in "$@"; do
    [[ "$argument" == "-d" || "$argument" == "--device-id" ||
      "$argument" == --device-id=* ]] && return 0
  done
  return 1
}

device_id_from_arguments() {
  local expect_device_id=false
  local argument
  for argument in "$@"; do
    if [[ "$expect_device_id" == true ]]; then
      printf '%s\n' "$argument"
      return 0
    fi
    case "$argument" in
      -d | --device-id)
        expect_device_id=true
        ;;
      --device-id=*)
        printf '%s\n' "${argument#*=}"
        return 0
        ;;
    esac
  done
  return 1
}

resolve_adb() {
  local candidate=""
  candidate="$(command -v adb 2>/dev/null || true)"
  if [[ -n "$candidate" && -x "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  for candidate in \
    "${ANDROID_SDK_ROOT:-}/platform-tools/adb" \
    "${ANDROID_HOME:-}/platform-tools/adb" \
    "$HOME/Library/Android/sdk/platform-tools/adb"; do
    if [[ "$candidate" != "/platform-tools/adb" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

recover_android_device() {
  local device_id="$1"
  local package_name="$2"
  local adb_bin=""
  local device_state=""
  local process_ids=""
  local forward_list=""
  local forward_count=0

  adb_bin="$(resolve_adb)" ||
    fail "--recover 需要 adb；请安装 Android SDK Platform-Tools 或配置 ANDROID_SDK_ROOT。"
  device_state="$("$adb_bin" -s "$device_id" get-state 2>/dev/null || true)"
  [[ "$device_state" == "device" ]] ||
    fail "设备 $device_id 当前状态为 ${device_state:-不可用}，不能执行安全恢复。"

  printf '\n正在恢复 Android 调试环境：%s\n' "$device_id"
  process_ids="$("$adb_bin" -s "$device_id" shell pidof "$package_name" 2>/dev/null | tr -d '\r' || true)"
  if [[ -n "$process_ids" ]]; then
    printf '  发现 MERP 残留进程：%s，正在停止...\n' "$process_ids"
  else
    printf '  未发现 MERP 残留进程。\n'
  fi
  "$adb_bin" -s "$device_id" shell am force-stop "$package_name" >/dev/null ||
    fail "停止 $package_name 失败，请检查设备授权状态。"
  process_ids="$("$adb_bin" -s "$device_id" shell pidof "$package_name" 2>/dev/null | tr -d '\r' || true)"
  [[ -z "$process_ids" ]] ||
    fail "无法停止 $package_name，残留进程仍为：$process_ids"

  forward_list="$("$adb_bin" -s "$device_id" forward --list 2>/dev/null || true)"
  if [[ -n "$forward_list" ]]; then
    forward_count="$(printf '%s\n' "$forward_list" | awk -v id="$device_id" '$1 == id { count += 1 } END { print count + 0 }')"
  fi
  if [[ "$forward_count" -gt 0 ]]; then
    printf '  发现旧 Flutter/ADB 端口转发：%s 条，正在清理...\n' "$forward_count"
  else
    printf '  未发现旧 ADB 端口转发。\n'
  fi
  "$adb_bin" -s "$device_id" forward --remove-all ||
    fail "清理设备 $device_id 的 ADB 端口转发失败。"
  printf '✓ Android 调试环境恢复完成；App 数据未清除。\n\n'
}

select_device() {
  local platform="$1"
  command -v ruby >/dev/null 2>&1 ||
    fail "自动选择设备需要 Ruby；也可以直接传入 -d <device-id>。"
  local devices_json
  devices_json="$(flutter devices --machine)"
  ruby -rjson -e '
    platform = ARGV.fetch(0)
    devices = JSON.parse(STDIN.read)
    device = devices.find do |item|
      target = item.fetch("targetPlatform", "")
      platform == "android" ? target.start_with?("android") : target.start_with?("ios")
    end
    puts device["id"] if device
  ' "$platform" <<<"$devices_json"
}

latest_artifact() {
  local marker="$1"
  local extension="$2"
  local artifact

  artifact="$(find "$ROOT_DIR/build" -type f -name "*.$extension" -newer "$marker" -print 2>/dev/null | head -n 1)"
  [[ -n "$artifact" ]] || fail "构建命令结束，但没有找到本次生成的 .$extension 产物。"
  printf '%s/%s\n' "$(cd "$(dirname "$artifact")" && pwd)" "$(basename "$artifact")"
}

print_artifact() {
  local environment="$1"
  local platform="$2"
  local version_name="$3"
  local build_number="$4"
  local marker="$5"
  local extension="$6"
  local artifact

  artifact="$(latest_artifact "$marker" "$extension")"

  printf '\n✓ 构建成功\n'
  printf '环境：%s\n' "$environment"
  printf '平台：%s\n' "$platform"
  printf '版本：%s+%s\n' "$version_name" "$build_number"
  printf '提交：%s\n' "$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || printf unknown)"
  printf '产物：%s\n' "$artifact"
}

generate_ios_ota_package() {
  local environment="$1"
  local version_name="$2"
  local build_number="$3"
  local marker="$4"
  local base_url="${IOS_OTA_BASE_URL:-}"
  local title="${IOS_OTA_TITLE:-MERP QAS}"
  local source_ipa
  local output_dir
  local ipa_name
  local ota_ipa
  local manifest
  local ipa_url

  [[ -n "$base_url" ]] ||
    fail "ios-ota 需要设置 IOS_OTA_BASE_URL，例如：IOS_OTA_BASE_URL=https://example.com/merp/ios ./tool/app build qas ios-ota"
  [[ "$base_url" == https://* ]] ||
    fail "IOS_OTA_BASE_URL 必须是 HTTPS 地址，iOS OTA 安装不接受普通 HTTP。"

  source_ipa="$(latest_artifact "$marker" ipa)"
  output_dir="$ROOT_DIR/build/ios/ota/$environment"
  ipa_name="merp-$environment-$version_name-$build_number.ipa"
  ota_ipa="$output_dir/$ipa_name"
  manifest="$output_dir/manifest.plist"
  ipa_url="${base_url%/}/$ipa_name"

  mkdir -p "$output_dir"
  cp "$source_ipa" "$ota_ipa"
  ruby "$TOOL_DIR/generate_ios_ota_manifest.rb" "$ota_ipa" "$manifest" "$ipa_url" "$title"

  printf '\n✓ iOS OTA 文件已生成\n'
  printf 'IPA：%s\n' "$ota_ipa"
  printf 'Plist：%s\n' "$manifest"
  printf '安装链接：itms-services://?action=download-manifest&url=%s/manifest.plist\n' "${base_url%/}"
}

COMMAND="${1:-}"
case "$COMMAND" in
  ide)
    [[ $# -eq 1 ]] || fail "ide 不接受额外的位置参数。"
    "$TOOL_DIR/configure_ide"
    exit 0
    ;;
  doctor)
    [[ $# -eq 1 ]] || fail "doctor 不接受额外的位置参数。"
    "$TOOL_DIR/bootstrap"
    flutter doctor -v
    printf '\n项目环境检查：\n'
    printf '  Flutter 固定版本：%s\n' "$FLUTTER_VERSION"
    printf '  Android flavors：qas / prd\n'
    printf '  iOS shared schemes：qas / prd\n'
    [[ -f "$ROOT_DIR/config/baidu_map.local.json" ]] ||
      printf '  [提示] 缺少 config/baidu_map.local.json，地图功能将没有本地 AK。\n'
    [[ -f "$ROOT_DIR/android/key.properties" ]] ||
      printf '  [提示] 缺少 android/key.properties，PRD Android 构建会被安全拦截。\n'
    exit 0
    ;;
  analyze)
    [[ $# -eq 1 ]] || fail "analyze 不接受额外的位置参数。"
    ensure_fvm
    cd "$ROOT_DIR"
    flutter analyze
    exit 0
    ;;
  test)
    [[ $# -eq 1 ]] || fail "test 不接受额外的位置参数。"
    ensure_fvm
    cd "$ROOT_DIR"
    flutter test
    exit 0
    ;;
  run | build)
    ;;
  *)
    fail "未知命令：${COMMAND:-<空>}"
    ;;
esac

ENVIRONMENT="${2:-}"
PLATFORM="${3:-}"
[[ "$ENVIRONMENT" == "qas" || "$ENVIRONMENT" == "prd" || "$ENVIRONMENT" == "mock" ]] ||
  fail "环境只能是 qas、mock 或 prd。"
[[ "$PLATFORM" == "android" || "$PLATFORM" == "ios" || "$PLATFORM" == "ios-ota" ]] ||
  fail "平台只能是 android、ios 或 ios-ota。"
if [[ "$COMMAND" == "run" && "$PLATFORM" == "ios-ota" ]]; then
  fail "ios-ota 只用于 build，运行调试请使用 ios。"
fi
if [[ "$COMMAND" == "build" && "$PLATFORM" == "ios-ota" && "$ENVIRONMENT" != "qas" ]]; then
  fail "ios-ota 当前只用于 QAS 测试分发；PRD 请走 app-store 构建。"
fi
if [[ "$COMMAND" == "build" && "$PLATFORM" == "ios-ota" ]]; then
  [[ -n "${IOS_OTA_BASE_URL:-}" ]] ||
    fail "ios-ota 需要设置 IOS_OTA_BASE_URL，例如：IOS_OTA_BASE_URL=https://example.com/merp/ios ./tool/app build qas ios-ota"
  [[ "${IOS_OTA_BASE_URL:-}" == https://* ]] ||
    fail "IOS_OTA_BASE_URL 必须是 HTTPS 地址，iOS OTA 安装不接受普通 HTTP。"
fi
if [[ "$COMMAND" == "run" && "$ENVIRONMENT" == "prd" ]]; then
  fail "不提供 run prd；本地日常运行固定使用 QAS。"
fi
if [[ "$COMMAND" == "build" && "$ENVIRONMENT" == "mock" ]]; then
  fail "mock 仅用于 Debug 启动，不允许构建或发布。"
fi

shift 3
# macOS 自带 Bash 3.2 在 `set -u` 下展开空数组会报 unbound variable。
# 保留一个不传给 Flutter 的占位元素，使“没有额外参数”也能安全执行。
EXTRA_ARGUMENTS=("")
RECOVER_ANDROID=false
for argument in "$@"; do
  if [[ "$argument" == "--recover" ]]; then
    RECOVER_ANDROID=true
  else
    EXTRA_ARGUMENTS+=("$argument")
  fi
done
if [[ "$RECOVER_ANDROID" == true &&
  ("$COMMAND" != "run" || "$PLATFORM" != "android") ]]; then
  fail "--recover 仅支持 Android run。"
fi
ensure_fvm
config_args "$ENVIRONMENT"
if [[ "$PLATFORM" == "android" ]]; then
  ensure_android_java
fi

cd "$ROOT_DIR"

if [[ "$COMMAND" == "run" ]]; then
  if ! has_device_argument "${EXTRA_ARGUMENTS[@]:1}"; then
    DEVICE_ID="$(select_device "$PLATFORM")"
    [[ -n "$DEVICE_ID" ]] ||
      fail "没有发现可用的 $PLATFORM 设备；请连接设备或传入 -d <device-id>。"
    EXTRA_ARGUMENTS=("" "-d" "$DEVICE_ID" "${EXTRA_ARGUMENTS[@]:1}")
    printf '使用 %s 设备：%s\n' "$PLATFORM" "$DEVICE_ID"
  fi
  if [[ "$RECOVER_ANDROID" == true ]]; then
    DEVICE_ID="$(device_id_from_arguments "${EXTRA_ARGUMENTS[@]:1}")"
    [[ -n "$DEVICE_ID" ]] || fail "--recover 无法确定目标 Android 设备。"
    recover_android_device "$DEVICE_ID" "com.delta.MERPDeltaTest"
  fi
  RUN_ARGUMENTS=(run --flavor qas)
  HAS_EXPLICIT_BUILD_MODE=false
  for argument in "${EXTRA_ARGUMENTS[@]:1}"; do
    case "$argument" in
      --debug|--profile|--jit-release|--release)
        HAS_EXPLICIT_BUILD_MODE=true
        break
        ;;
    esac
  done
  if [[ "$HAS_EXPLICIT_BUILD_MODE" == false ]]; then
    RUN_ARGUMENTS+=(--debug)
  fi
  RUN_ARGUMENTS+=(--target lib/main.dart)
  flutter "${RUN_ARGUMENTS[@]}" \
    "${CONFIG_ARGUMENTS[@]}" \
    "${EXTRA_ARGUMENTS[@]:1}"
  exit 0
fi

VERSION_NAME="${BUILD_NAME:-$(project_version)}"
BUILD_NUMBER="${BUILD_NUMBER:-$(project_build_number)}"
[[ -n "$VERSION_NAME" && -n "$BUILD_NUMBER" ]] ||
  fail "无法从 pubspec.yaml 读取版本号或构建编号。"
[[ "$BUILD_NUMBER" =~ ^[0-9]{5}$ ]] ||
  fail "BUILD_NUMBER 必须是五位数字（例如 10000），当前值：$BUILD_NUMBER"

if [[ "$ENVIRONMENT" == "prd" ]]; then
  validate_prd_config
  confirm_prd
fi

mkdir -p "$ROOT_DIR/.tool-cache"
MARKER="$ROOT_DIR/.tool-cache/build-start"
touch "$MARKER"

if [[ "$PLATFORM" == "android" && "$ENVIRONMENT" == "qas" ]]; then
  flutter build apk --flavor qas --release --target lib/main.dart \
    --target-platform android-arm64 --split-per-abi \
    "${CONFIG_ARGUMENTS[@]}" --build-name "$VERSION_NAME" \
    --build-number "$BUILD_NUMBER" "${EXTRA_ARGUMENTS[@]:1}"
  print_artifact qas android "$VERSION_NAME" "$BUILD_NUMBER" "$MARKER" apk
elif [[ "$PLATFORM" == "android" ]]; then
  flutter build appbundle --flavor prd --release --target lib/main.dart \
    --target-platform android-arm64 \
    "${CONFIG_ARGUMENTS[@]}" --build-name "$VERSION_NAME" \
    --build-number "$BUILD_NUMBER" "${EXTRA_ARGUMENTS[@]:1}"
  print_artifact prd android "$VERSION_NAME" "$BUILD_NUMBER" "$MARKER" aab
elif [[ "$ENVIRONMENT" == "qas" ]]; then
  EXPORT_METHOD="development"
  if [[ "$PLATFORM" == "ios-ota" ]]; then
    EXPORT_METHOD="ad-hoc"
  fi
  flutter build ipa --flavor qas --release --target lib/main.dart \
    --export-method "$EXPORT_METHOD" "${CONFIG_ARGUMENTS[@]}" \
    --build-name "$VERSION_NAME" --build-number "$BUILD_NUMBER" \
    "${EXTRA_ARGUMENTS[@]:1}"
  print_artifact qas ios "$VERSION_NAME" "$BUILD_NUMBER" "$MARKER" ipa
  if [[ "$PLATFORM" == "ios-ota" ]]; then
    generate_ios_ota_package qas "$VERSION_NAME" "$BUILD_NUMBER" "$MARKER"
  fi
else
  flutter build ipa --flavor prd --release --target lib/main.dart \
    --export-method app-store "${CONFIG_ARGUMENTS[@]}" \
    --build-name "$VERSION_NAME" --build-number "$BUILD_NUMBER" \
    "${EXTRA_ARGUMENTS[@]:1}"
  print_artifact prd ios "$VERSION_NAME" "$BUILD_NUMBER" "$MARKER" ipa
fi
